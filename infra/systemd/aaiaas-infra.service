[Unit]
Description=aaIaaS.ai infrastructure (Postgres/Redis/Meilisearch/Mailhog)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Set this to your deploy directory (where docker-compose.yml lives)
WorkingDirectory=/opt/aaiaas

# Use the Docker Compose v2 plugin ("docker compose ...")
ExecStart=/usr/bin/env docker compose up -d
ExecStop=/usr/bin/env docker compose down

TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
